{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api", "destination": "/api.html" },
    { "source": "/api-keys", "destination": "/api-keys.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
