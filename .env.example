# Copy to .env locally (ignored); set production values in Vercel.
# Never paste secrets into frontend code or commit them.
APP_ORIGIN=https://www.dethe.in
# Generate a random secret of at least 32 bytes; rotation signs everyone out.
SESSION_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.dethe.in/api/auth/google/callback

# Private account/key database. Retain your existing repository for migration.
GITHUB_DB_REPO=pratikdethe06-create/dethe-api-db
# Scoped token: Contents read/write on the private database repository only.
GITHUB_DB_TOKEN=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Premium speech + real transcription; no STT demo fallback.
SARVAM_API_KEY=
# AI writing: Sarvam is also supported; these are optional alternatives.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional model overrides:
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_STT_MODEL=saarika:v2.5
# SARVAM_CHAT_MODEL=sarvam-105b
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_MODEL=gpt-4o-mini

# Local integration tests only: synthetic credentials, never real provider keys.
# APP_ORIGIN=http://localhost:8080
# GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
# GITHUB_API_URL=http://localhost:4100
# GOOGLE_AUTH_URL=http://localhost:4101/o/oauth2/v2/auth
# GOOGLE_TOKEN_URL=http://localhost:4101/oauth2/token
# GOOGLE_USERINFO_URL=http://localhost:4101/oauth2/v2/userinfo
# Other supported endpoint overrides: RAZORPAY_API_URL, SARVAM_TTS_URL,
# SARVAM_STT_URL, SARVAM_CHAT_URL. Use trusted endpoints only.
