# DetheAI backend ke liye environment variables
# Inhe Vercel dashboard me daalna hai (Project → Settings → Environment Variables)
# Ya `vercel env add <NAME>` se CLI par.

# ── ZAROORI (recommended) ─────────────────────────────────────────────
# Sarvam AI — original TTS provider (dethe.in ke saare 37 voices isi ke hain)
# Free API key: https://dashboard.sarvam.ai → API Keys
# Bina is key ke: 10/11 languages free Google TTS se chalengi (Odia nahi chalega)
SARVAM_API_KEY=

# ── REAL GOOGLE LOGIN (console.cloud.google.com se) ──────────────────
# OAuth client banate waqt redirect URI ye rakhein:
#   https://www.dethe.in/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── PAYMENTS (dashboard.razorpay.com → Settings → API Keys) ─────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── OPTIONAL ──────────────────────────────────────────────────────────
# AI Script Assistant (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# OpenAI (Gemini ke bina backup)
OPENAI_API_KEY=

# ── ADVANCED (mat chhedo) ─────────────────────────────────────────────
# SARVAM_TTS_MODEL=bulbul:v3
# GEMINI_MODEL=gemini-2.0-flash
# GOOGLE_REDIRECT_URI=https://www.dethe.in/api/auth/google/callback
