# DetheAI backend ke liye environment variables
# Inhe Vercel dashboard me daalna hai (Project → Settings → Environment Variables)
# Ya `vercel env add <NAME>` se CLI par.

# ── ZAROORI (recommended) ─────────────────────────────────────────────
# Sarvam AI — original TTS provider (dethe.in ke saare 37 voices isi ke hain)
# Free API key: https://dashboard.sarvam.ai → API Keys
# Bina is key ke: 10/11 languages free Google TTS se chalengi (Odia nahi chalega)
SARVAM_API_KEY=

# ── OPTIONAL ──────────────────────────────────────────────────────────
# AI Script Assistant (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenAI (Gemini ke bina backup)
OPENAI_API_KEY=

# Real Google login chahiye to (warna demo login chalega)
GOOGLE_CLIENT_ID=

# ── ADVANCED (mat chhedo) ─────────────────────────────────────────────
# SARVAM_TTS_MODEL=bulbul:v3
# GEMINI_MODEL=gemini-2.0-flash
